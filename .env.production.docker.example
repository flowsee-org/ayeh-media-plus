# ══════════════════════════════════════════════════════════════════════════════
# Ayeh Media Plus — local production-like Docker Compose template
# Copy to an UNTRACKED file (e.g. `.env.production.docker`) and fill values.
# Never commit real secrets. Never point this at Production or shared Staging DBs.
# ═══════════════════════════════════════════════════════════════════════════════

# Compose project name (keeps volumes/containers isolated from other local stacks)
COMPOSE_PROJECT_NAME=ayeh-prod-local

# Public entry (Nginx)
AYEH_PUBLIC_PORT=8080

# ─── Shared app secrets (must be unique & ≥16 chars; not well-known defaults) ───
JWT_SECRET=local-docker-jwt-secret-change-me-32c
OTP_PEPPER=local-docker-otp-pepper-change-me-32c

# Browser origin must match how you open the stack (host:port)
CORS_ORIGIN=http://localhost:8080
APP_PUBLIC_URL=http://localhost:8080
# Leave empty when Nginx fronts both services (same-origin /api, /uploads, /socket.io)
NEXT_PUBLIC_API_BASE=

# ─── PostgreSQL (Compose `db` service — not published publicly by default) ───
POSTGRES_USER=ayeh_app
POSTGRES_PASSWORD=ayeh_local_docker_password_change_me
POSTGRES_DB=ayeh_prod_local
# Used by api / migrate. Host `db` is the Compose DNS name on the private network.
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://ayeh_app:ayeh_local_docker_password_change_me@db:5432/ayeh_prod_local?schema=public

# ─── Auth delivery (NODE_ENV=production refuses console providers) ─────────────
# Production fail-closed requires non-empty SMTP_USER + SMTP_PASS even for local
# MailHog smoke (MailHog ignores auth). Real Brevo delivery needs real credentials
# + a verified EMAIL_FROM. TextBee placeholders allow process start only — they do
# not send SMS until a real API key, device ID, and online Android gateway exist.
EMAIL_PROVIDER=smtp
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=mailhog
SMTP_PASS=mailhog
EMAIL_FROM="Ayeh Media Plus Local Docker <noreply@localhost>"
SMTP_TIMEOUT_MS=15000
# MailHog is plaintext — do not force STARTTLS here. Brevo uses port 587 + STARTTLS.
SMTP_REQUIRE_TLS=false
SMTP_TLS_REJECT_UNAUTHORIZED=true

SMS_PROVIDER=textbee
TEXTBEE_API_KEY=local-docker-textbee-api-key-not-real
TEXTBEE_DEVICE_ID=local-docker-textbee-device-id
TEXTBEE_TIMEOUT_MS=15000
# Optional Twilio alternative (set SMS_PROVIDER=twilio and fill these):
# TWILIO_ACCOUNT_SID=ACaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# TWILIO_AUTH_TOKEN=local-docker-twilio-token-not-real
# TWILIO_FROM_NUMBER=+15005550006
