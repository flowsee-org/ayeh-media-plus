# ══════════════════════════════════════════════════════════════════════════════
# Ayeh Media Plus — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# Never commit real SMTP / Brevo / TextBee / Twilio secrets.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Server ───
PORT=5000
NODE_ENV=development

# ─── Database ───
# Provider: "sqlite" (development) or "postgresql" (production)
DATABASE_PROVIDER="sqlite"

# SQLite (development only)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production) — configure for your managed database:
# DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"
# DATABASE_SSL_MODE="require"
# DATABASE_CONNECTION_LIMIT="20"

# ─── Security ───
# ⚠️  CHANGE THIS IN PRODUCTION / STAGING — never use the well-known default.
# Production aborts if JWT_SECRET is missing or equals ayeh_default_secret_2026.
JWT_SECRET="your-super-secret-jwt-key-change-me-in-production"
# Dedicated pepper for hashing stored OTPs (recommended). Falls back to JWT_SECRET.
# Production refuses weak/default peppers (including ayeh_dev_otp_pepper).
# OTP_PEPPER=""

# Allowed CORS origins (comma-separated)
CORS_ORIGIN="http://localhost:5173,http://localhost:5000"

# Public app URL used in password-reset email links
APP_PUBLIC_URL="http://localhost:5173"

# ─── API ───
# Public API base URL for Next.js rewrites (development) / optional absolute API host.
# Development: http://localhost:5000 (Next rewrites → Express)
# Production behind Nginx/Caddy (recommended): leave EMPTY so the browser uses
# same-origin /api, /uploads, /socket.io (proxy routes those to Express).
# Do not set this to an internal Docker hostname — browsers cannot resolve it.
NEXT_PUBLIC_API_BASE=""

# ─── Production Docker packaging (Task 13) ───
# See `.env.production.docker.example` + `docker-compose.prod.example.yml`
# and `docs/DEPLOYMENT_RUNBOOK.md` §14. Migrations: `scripts/migrate-deploy.sh`
# (never auto-migrate on container start). Staging template remains `.env.staging.example`.

# ─── Auth delivery (email / SMS OTP) — Task 15 ───
# Development defaults: EMAIL_PROVIDER=console, SMS_PROVIDER=console
# Production / Staging (NODE_ENV=production) defaults: EMAIL_PROVIDER=smtp, SMS_PROVIDER=textbee
# Production refuses console providers and aborts startup if credentials are missing.
# AUTH_DELIVERY_REQUIRED=false is IGNORED in production (fail-closed). In development,
# set AUTH_DELIVERY_REQUIRED=true to force the same validation locally.
#
# EMAIL_PROVIDER=console
# SMS_PROVIDER=console
# AUTH_DELIVERY_REQUIRED=true
#
# Staging template: copy `.env.staging.example` → untracked `.env.staging`
#
# ── Brevo SMTP (Nodemailer) — required when EMAIL_PROVIDER=smtp ──
# Create a Brevo account → verify sender → SMTP & API → SMTP key.
# Host/port below are Brevo's public relay defaults (STARTTLS on 587).
# EMAIL_FROM must match a sender verified in Brevo.
# EMAIL_PROVIDER=smtp
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-brevo-smtp-login"
# SMTP_PASS="your-brevo-smtp-key"
# EMAIL_FROM="Ayeh Media Plus <noreply@your-verified-domain.example>"
# SMTP_TIMEOUT_MS="15000"
# Port 587 enables STARTTLS (requireTLS) automatically. Certificate validation is on.
# SMTP_REQUIRE_TLS="true"
# SMTP_TLS_REJECT_UNAUTHORIZED="true"
#
# ── TextBee SMS (Android gateway) — default when SMS_PROVIDER=textbee (prod default) ──
# Docs: https://textbee.dev/docs/sending-sms
# Requires: Android 7+ phone, TextBee app online, active SIM that can send SMS.
# Free plan limits (not unlimited): 50 msgs/day, 300/month, 1 device.
# Carrier/SIM charges may still apply. HTTP 200 = API accepted/queued, not delivered.
# SMS_PROVIDER=textbee
# TEXTBEE_API_KEY="your-textbee-api-key"
# TEXTBEE_DEVICE_ID="your-registered-device-id"
# TEXTBEE_TIMEOUT_MS="15000"
# TEXTBEE_BASE_URL="https://api.textbee.dev/api/v1"
#
# ── Twilio SMS (optional alternative) — when SMS_PROVIDER=twilio ──
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER="+15005550006"
# TWILIO_TIMEOUT_MS="15000"
#
# OTP / abuse controls (in-memory per process — not multi-instance safe alone)
# AUTH_OTP_VERIFY_MAX="5"
# AUTH_OTP_SEND_MAX="8"
# AUTH_OTP_RESEND_COOLDOWN_MS="60000"
# AUTH_LOGIN_MAX_ATTEMPTS="20"
# AUTH_RATE_LIMIT_WINDOW_MS="900000"
# AUTH_RATE_LIMIT_DISABLED="false"
#
# Dev-only verbose console bodies (never enable in production)
# EMAIL_CONSOLE_VERBOSE="false"
# SMS_CONSOLE_VERBOSE="false"
#
# Gated live provider check (never run in CI): scripts/live-delivery-verify.mjs
# ALLOW_LIVE_DELIVERY_TEST="true"
# LIVE_DELIVERY_EMAIL="you@example.com"
# LIVE_DELIVERY_PHONE="+98912…"

# ─── LiveKit WebRTC SFU (Task 16 / Live Streaming) ───
# For self-hosted: LIVEKIT_URL="ws://localhost:7880"
# For LiveKit Cloud: LIVEKIT_URL="wss://<project>.livekit.cloud"
# Client connects via NEXT_PUBLIC_LIVEKIT_URL
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
NEXT_PUBLIC_LIVEKIT_URL="ws://localhost:7880"

# ─── AI Integration (optional) ───
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# ─── Legacy / Compatibility ───
VITE_BASE44_APP_ID="your-base44-app-id"
