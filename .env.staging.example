# ══════════════════════════════════════════════════════════════════════════════
# Ayeh Media Plus — Staging environment template
# Copy to an untracked `.env.staging` (or inject via your host secrets manager).
# Never commit real Staging secrets. Never reuse Production credentials or DBs.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Runtime ───
NODE_ENV=production
PORT=5000

# ─── Database (dedicated Staging Postgres — never SQLite, never Production URL) ───
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://STAGING_USER:STAGING_PASSWORD@STAGING_HOST:5432/ayeh_staging?schema=public
DATABASE_SSL_MODE=require
# DATABASE_CONNECTION_LIMIT=20

# ─── Security (unique Staging secrets — not Production, not defaults) ───
JWT_SECRET=replace-with-unique-staging-jwt-secret-32chars
OTP_PEPPER=replace-with-unique-staging-otp-pepper-32chars
CORS_ORIGIN=https://staging.example.com
APP_PUBLIC_URL=https://staging.example.com
NEXT_PUBLIC_API_BASE=

# ─── Auth delivery (real providers required under NODE_ENV=production) ───
# AUTH_DELIVERY_REQUIRED=false is IGNORED / refused in production — do not set it.
#
# Brevo SMTP — verify sender in Brevo; EMAIL_FROM must match that sender.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Ayeh Media Plus Staging <noreply-staging@example.com>"
SMTP_TIMEOUT_MS=15000
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true

# TextBee SMS — Android 7+ phone + TextBee app + active SIM required for real sends.
# Free plan: 50/day, 300/month, 1 device (carrier charges may apply). Not unlimited.
SMS_PROVIDER=textbee
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_TIMEOUT_MS=15000
# TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
#
# Optional Twilio alternative:
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_TIMEOUT_MS=15000

# Optional OTP / abuse tuning (in-memory per process — not multi-instance safe)
# AUTH_OTP_VERIFY_MAX=5
# AUTH_OTP_SEND_MAX=8
# AUTH_OTP_RESEND_COOLDOWN_MS=60000
# AUTH_LOGIN_MAX_ATTEMPTS=20
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_DISABLED must remain unset/false in Staging/Production

# ─── Optional AI ───
# OPENAI_API_KEY=
# GEMINI_API_KEY=
