CORS_ORIGIN="http://localhost:5173,http://localhost:5000"
# Public API base URL for Next.js rewrites (leave empty for same-origin in production).
# In development this is http://localhost:5000 to proxy to the Express backend.
NEXT_PUBLIC_API_BASE=""
