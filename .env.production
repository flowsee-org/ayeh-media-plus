PORT=5000
# Database provider: "sqlite" (dev) or "postgresql" (production)
DATABASE_PROVIDER="postgresql"
# PostgreSQL (production)
DATABASE_URL="file:./dev.db"
DATABASE_SSL_MODE="require"
DATABASE_CONNECTION_LIMIT="20"
